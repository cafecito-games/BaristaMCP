[configuration]

entry_symbol = "barista_mcp_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

macos.debug = "./macos/libbarista_mcp.macos.template_debug.arm64.dylib"
macos.release = "./macos/libbarista_mcp.macos.template_release.arm64.dylib"
windows.debug.x86_64 = "./windows/barista_mcp.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./windows/barista_mcp.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./linux/libbarista_mcp.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./linux/libbarista_mcp.linux.template_release.x86_64.so"
